# Root ignores for the monorepo. Each app keeps its own .gitignore too.
node_modules
.next
.env*.local
.DS_Store
.vercel
# Secrets, wherever they land (apps/web/.gitignore has the same patterns)
*serviceAccountKey*.json
firebase-adminsdk*.json
*.pem
# Personal Claude Code permissions; the shared ones live in .claude/settings.json
.claude/settings.local.json
